# shellcheck shell=bash disable=2034,2154,2164
# NDK, API and LEVEL are provided by the enviroment

org="org.blisslabs.ag"
pkgbase="libcompat"
pkgname=("${pkgbase}" "${pkgbase}-dev")
pkgver=1.0.0
pkgrel=1
arch=('x86_64')
_x86_64_microarch_level="${LEVEL#v}"
api_level=${API}
depends=()
provides=()
makedepends=()

source=("libcompat::git+https://github.com/ag-sdc/libcompat")
md5sums=('SKIP')

pkgver() {
	cat "$srcdir/libcompat/VERSION"
}

prepare() {
	cd "$srcdir/libcompat"
	cmake \
		-DCMAKE_TOOLCHAIN_FILE="${NDK}/build/cmake/android.toolchain.cmake" \
		-DANDROID_ABI="x86_64" \
		-DANDROID_PLATFORM="android-${API}" \
		-DCMAKE_INSTALL_PREFIX="/apex/$org.$pkgbase"
}

build() {
	cd "$srcdir/libcompat"
	make -j"$(nproc)"
}

package_libcompat() {
	cd "$srcdir/libcompat"
	make DESTDIR=. install_lib
	cp -a "apex/$org.$pkgbase"/. "$pkgdir/"
}

package_libcompat-dev() {
	depends+=("libcompat.so") # force -dev package to depend on original package
	cd "$srcdir/libcompat"
	make DESTDIR=. install_dev
	cp -a "apex/$org.$pkgbase"/. "$pkgdir/"
}
