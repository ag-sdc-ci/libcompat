# shellcheck shell=bash disable=2034,2154,2164
# NDK, API and LEVEL are provided by the enviroment

org="org.blisslabs.ag"
pkgname="libcompat"
pkgver=1.0.0
pkgrel=1
arch=('x86_64')
_x86_64_microarch_level="${LEVEL#v}"
depends=()
provides=()
makedepends=()
split_packages=("${pkgname}" "${pkgname}-headers")

source=("libcompat::git+https://github.com/ag-sdc/libcompat")
md5sums=('SKIP')

pkgver() {
	cat "$srcdir/libcompat/VERSION"
}

prepare() {
	cd "$srcdir/libcompat"
	cmake \
		-DCMAKE_TOOLCHAIN_FILE="${NDK}/build/cmake/android.toolchain.cmake" \
		-DANDROID_ABI="x86_64" \
		-DANDROID_PLATFORM="android-${API}" \
		-DCMAKE_INSTALL_PREFIX="/apex/$org.$pkgname"
	echo "dbg: NDK=$NDK"
	echo "dbg: API=$API"
	echo "dbg: LEVEL=$LEVEL"
}

build() {
	cd "$srcdir/libcompat"
	make -j"$(nproc)"
}

package_libcompat() {
	cd "$srcdir/libcompat"
	make DESTDIR=. install_lib
	find
	pwd
	ls
	ls apex
	ls apex/$org.$pkgname
	cp -a "apex/$org.$pkgname"/. "$pkgdir/"
}

package_libcompat-headers() {
	cd "$srcdir/libcompat"
	make DESTDIR=. install_headers
	cp -a "apex/$org.$pkgname"/. "$pkgdir/"
}
