org="org.blisslabs.ag"
pkgname="libcompat"
pkgver=master
pkgrel=1
arch=('x86_64')
_x86_64_microarch_level="${LEVEL#v}"
depends=()
provides=()
makedepends=()
split_packages=("${pkgname}" "${pkgname}_headers")

source=()
md5sums=()

build() {
    mkdir -p "$startdir/build"
    cd "$startdir/build"
    cmake "$startdir" \
        -DCMAKE_TOOLCHAIN_FILE=${NDK}/build/cmake/android.toolchain.cmake \
        -DANDROID_ABI=x86_64 \
        -DANDROID_PLATFORM=android-${API} \
        -DCMAKE_INSTALL_PREFIX=/apex/org.blisslabs.ag.libcompat
    make -j$(nproc)
}

package_libcompat() {
    cd "$startdir/build"
    make install DESTDIR="$startdir/build/output"
    install -d "$pkgdir"
    cp -a "$startdir/build/output/apex/org.blisslabs.ag.libcompat"/. "$pkgdir/"
    rm -rf "$pkgdir/include" 2>/dev/null || true
}

package_libcompat_headers() {
    cd "$startdir/build"
    install -d "$pkgdir"
    cp -a "$startdir/build/output/apex/org.blisslabs.ag.libcompat/include" "$pkgdir/"
}
